#!/usr/bin/env bash
# ccwt - Claude Code WorkTree manager
# See docs/worktree-workflow.md for design.
set -euo pipefail

ccwt_state_dir() {
  local repo
  repo=$(basename "$(git rev-parse --show-toplevel)")
  echo "${XDG_STATE_HOME:-$HOME/.local/state}/ccwt/${repo}"
}

ccwt_commander_file() { echo "$(ccwt_state_dir)/commander"; }
ccwt_pane_file() { echo "$(ccwt_state_dir)/panes/$(ccwt_sanitize "$1")"; }

ccwt_sanitize() {
  # branch -> safe identifier (docker name + filename).
  # Match gwq's path convention which replaces '/' with '-'.
  printf '%s' "$1" | tr '/' '-'
}

ccwt_send_line() {
  local pane=$1 text=$2
  wezterm cli send-text --no-paste --pane-id "$pane" "$text"
  printf '\r' | wezterm cli send-text --no-paste --pane-id "$pane"
}

ccwt_config_file() {
  echo "${XDG_CONFIG_HOME:-$HOME/.config}/ccwt/config.toml"
}

# Emit one "<marketplace>/<plugin>" line per (marketplace, plugin)
# pair listed in config.toml. Silently emits nothing if the config
# file or yq/jq is missing.
#
# Expected schema:
#   [[marketplaces]]
#   name    = "kiconia-plugins"
#   plugins = ["mise", "uv"]
#
#   [[marketplaces]]
#   name    = "claude-plugins-official"
#   plugins = ["github"]
ccwt_read_plugins() {
  local cfg
  cfg=$(ccwt_config_file)
  [[ -f $cfg ]] || return 0
  command -v yq >/dev/null 2>&1 || return 0
  command -v jq >/dev/null 2>&1 || return 0
  yq -p toml -o json '.marketplaces // []' "$cfg" 2>/dev/null \
    | jq -r '.[] | .name as $m | (.plugins // [])[] | "\($m)/\(.)"'
}

# Resolve <marketplace>/<name> to the latest version directory under
# ~/.claude/plugins/cache/. Returns non-zero if not installed locally.
ccwt_resolve_plugin_dir() {
  local marketplace=$1 name=$2
  local base="$HOME/.claude/plugins/cache/$marketplace/$name"
  [[ -d $base ]] || return 1
  local latest
  # shellcheck disable=SC2012  # version dirs are semver/'unknown', ls is fine
  latest=$(ls -1 "$base" 2>/dev/null | sort -V | tail -n1)
  [[ -n $latest && -d "$base/$latest" ]] || return 1
  echo "$base/$latest"
}

cmd_init() {
  local state pane
  state=$(ccwt_state_dir)
  mkdir -p "$state/panes"
  pane=${WEZTERM_PANE:-}
  if [[ -z $pane ]]; then
    echo "ccwt init: WEZTERM_PANE is not set. Run inside a WezTerm pane." >&2
    exit 1
  fi
  echo "$pane" > "$(ccwt_commander_file)"
  echo "ccwt: commander pane = $pane"
  echo "ccwt: state dir      = $state"
}

cmd_spawn() {
  local branch=${1:?usage: ccwt spawn <branch> [initial-task]}
  local task=${2:-}
  local commander pane worktree name commander_file
  commander_file=$(ccwt_commander_file)
  if [[ ! -f $commander_file ]]; then
    echo "ccwt spawn: run 'ccwt init' first." >&2
    exit 1
  fi
  commander=$(cat "$commander_file")
  name="ccwt-$(ccwt_sanitize "$branch")"

  if git rev-parse --verify --quiet "refs/heads/$branch" >/dev/null 2>&1; then
    gwq add "$branch"
  else
    gwq add -b "$branch"
  fi
  worktree=$(gwq get "$branch")

  # host-side mise loads the worktree's mise.toml when the new pane's cwd
  # is set there; pre-trust it to avoid prompt noise on every command.
  if [[ -f "$worktree/mise.toml" ]] && command -v mise >/dev/null 2>&1; then
    mise trust --quiet "$worktree/mise.toml" >/dev/null 2>&1 || true
  fi

  pane=$(wezterm cli split-pane --bottom --percent 30 \
    --pane-id "$commander" --cwd "$worktree")
  echo "$pane" > "$(ccwt_pane_file "$branch")"

  # Resolve host-installed plugins listed in ~/.config/ccwt/config.toml and
  # bind-mount each one read-only at /plugins/<name> inside the worker.
  local mount_args=() plugin_dir_args=""
  local entry marketplace plugin_name host_dir
  while IFS= read -r entry; do
    [[ -z $entry || $entry == null/null ]] && continue
    marketplace=${entry%%/*}
    plugin_name=${entry#*/}
    if ! host_dir=$(ccwt_resolve_plugin_dir "$marketplace" "$plugin_name"); then
      echo "ccwt spawn: skipping plugin '$entry' (not installed locally)" >&2
      continue
    fi
    mount_args+=(-v "$host_dir:/plugins/$plugin_name:ro")
    plugin_dir_args+=" --plugin-dir /plugins/$plugin_name"
  done < <(ccwt_read_plugins)

  docker run -d --name "$name" \
    -v "$worktree:/workspace" \
    ${mount_args[@]+"${mount_args[@]}"} \
    -w /workspace \
    "${CCWT_IMAGE:-tedsum/claude-code-mise:latest}" \
    sleep infinity >/dev/null

  ccwt_send_line "$pane" "docker exec -it $name claude${plugin_dir_args}"

  if [[ -n $task ]]; then
    # Wait for the REPL to be ready; an initial task sent too early is lost.
    sleep "${CCWT_SPAWN_WAIT:-5}"
    ccwt_send_line "$pane" "$task"
  fi

  echo "ccwt: spawned worker '$branch'"
  echo "  pane-id   = $pane"
  echo "  worktree  = $worktree"
  echo "  container = $name"
}

cmd_tell() {
  local branch=${1:?usage: ccwt tell <branch> <message>}
  shift
  local message="$*"
  local pane_file pane
  pane_file=$(ccwt_pane_file "$branch")
  if [[ ! -f $pane_file ]]; then
    echo "ccwt tell: no worker named '$branch'." >&2
    exit 1
  fi
  pane=$(cat "$pane_file")
  ccwt_send_line "$pane" "$message"
}

cmd_list() {
  echo "# active worker containers"
  docker ps --filter 'name=^ccwt-' --format 'table {{.Names}}\t{{.Status}}\t{{.Image}}' || true
  echo
  echo "# gwq worktrees"
  gwq list || true
}

cmd_cleanup() {
  local branch=${1:?usage: ccwt cleanup <branch>}
  local name pane pane_file
  name="ccwt-$(ccwt_sanitize "$branch")"
  pane_file=$(ccwt_pane_file "$branch")

  docker rm -f "$name" 2>/dev/null || true

  if [[ -f $pane_file ]]; then
    pane=$(cat "$pane_file")
    wezterm cli kill-pane --pane-id "$pane" 2>/dev/null || true
    rm -f "$pane_file"
  fi

  echo "ccwt: stopped container '$name' and killed pane."
  echo "ccwt: run 'gwq remove $branch' to drop the worktree (not done automatically)."
}

cmd_help() {
  cat <<'EOF'
Usage: ccwt <command> [args...]

Commands:
  init                       Register the current WezTerm pane as commander.
  spawn <branch> [<task>]    Create a worktree, split a pane, start a worker.
  tell <branch> <message>    Send a message to a worker's REPL.
  list                       List active workers and worktrees.
  cleanup <branch>           Stop container and kill pane (worktree kept).
  help                       Show this help.

Env:
  CCWT_IMAGE        Override docker image (default: tedsum/claude-code-mise:latest)
  CCWT_SPAWN_WAIT   Seconds to wait before sending the initial task (default: 5)
  XDG_CONFIG_HOME   Used to locate config.toml (default: ~/.config)

Config:
  ~/.config/ccwt/config.toml — list of [[plugin]] entries (marketplace/name)
  whose host-installed copy is bind-mounted into the worker and passed via
  `claude --plugin-dir` so the worker sees the same plugins as the host.

See docs/worktree-workflow.md for design.
EOF
}

main() {
  local cmd=${1:-help}
  shift || true
  case "$cmd" in
    init)    cmd_init "$@" ;;
    spawn)   cmd_spawn "$@" ;;
    tell)    cmd_tell "$@" ;;
    list)    cmd_list "$@" ;;
    cleanup) cmd_cleanup "$@" ;;
    help|-h|--help) cmd_help ;;
    *) echo "ccwt: unknown command '$cmd'" >&2; cmd_help; exit 2 ;;
  esac
}

main "$@"
