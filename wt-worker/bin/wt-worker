#!/usr/bin/env bash
# wt-worker - Claude Code parallel worker manager (WorkTree + WezTerm)
# See docs/worktree-workflow.md for design.
set -euo pipefail

wt_worker_state_dir() {
  local repo
  repo=$(basename "$(git rev-parse --show-toplevel)")
  echo "${XDG_STATE_HOME:-$HOME/.local/state}/wt-worker/${repo}"
}

wt_worker_pane_file()      { echo "$(wt_worker_state_dir)/panes/$(wt_worker_sanitize "$1")"; }
wt_worker_repo_file()      { echo "$(wt_worker_state_dir)/repos/$(wt_worker_sanitize "$1")"; }
wt_worker_refresher_pid()  { echo "$(wt_worker_state_dir)/refreshers/$(wt_worker_sanitize "$1").pid"; }
wt_worker_refresher_log()  { echo "$(wt_worker_state_dir)/refreshers/$(wt_worker_sanitize "$1").log"; }

wt_worker_sanitize() {
  # branch -> safe identifier for sbx name + filename
  printf '%s' "$1" | tr '/' '-'
}

wt_worker_send_line() {
  local pane=$1 text=$2
  wezterm cli send-text --no-paste --pane-id "$pane" "$text"
  printf '\r' | wezterm cli send-text --no-paste --pane-id "$pane"
}

wt_worker_config_file() {
  echo "${XDG_CONFIG_HOME:-$HOME/.config}/wt-worker/config.toml"
}

# Resolve "github.com/<owner>/<repo>" from the current repo's origin URL.
# Returns non-zero if origin is missing or not parseable.
wt_worker_origin_path() {
  local url
  url=$(git remote get-url origin 2>/dev/null) || return 1
  [[ -n $url ]] || return 1
  url=${url%.git}
  # ssh forms: git@host:owner/repo, ssh://git@host/owner/repo
  url=${url#ssh://}
  url=${url#git@}
  url=${url/:/\/}
  # https forms: https://host/owner/repo
  url=${url#https://}
  url=${url#http://}
  echo "$url"
}

# Mint a scoped GitHub App installation token via the external
# `agent-gh-repo-token` CLI (https://github.com/td72/agent-gh-repo-token) and
# store it as the sandbox's per-sandbox `github` secret. Best-effort: any
# failure just emits a warning and leaves the sandbox without GitHub auth
# (worker can still read public repos but cannot push). If the CLI is not
# installed, wt-worker silently falls back to the global `github` secret
# (if any).
wt_worker_inject_github_secret() {
  local sandbox=$1 repo=$2 caller=${3:-spawn}
  local err_file token
  if ! command -v agent-gh-repo-token >/dev/null 2>&1; then
    # No-op: fall back to whatever global `github` secret the user set.
    return 0
  fi
  err_file=$(mktemp -t agent-gh-repo-token.XXXXXX)
  if token=$(agent-gh-repo-token --repo "$repo" 2>"$err_file"); then
    rm -f "$err_file"
    if [[ -n $token ]]; then
      printf '%s' "$token" | sbx secret set "$sandbox" github >/dev/null
      echo "wt-worker $caller: scoped github token stored on sandbox=$sandbox" >&2
      return 0
    fi
  else
    echo "wt-worker $caller: github auth failed ($(cat "$err_file"))" >&2
    rm -f "$err_file"
  fi
  return 1
}

# Pre-authenticate `gh` inside the sandbox AND force git to reach github over
# HTTPS, so workers can `git push origin` + `gh pr create` directly.
#
# Two things are configured (both in the container's persistent HOME, so they
# survive into the later `sbx run` session):
#   1. ~/.config/gh/hosts.yml with a sentinel oauth_token — the sbx proxy
#      overwrites the Authorization header on github.com with the real
#      per-sandbox `github` secret, so gh only needs to believe it is logged in.
#   2. git pushInsteadOf/insteadOf rewriting git@github.com: -> https://github.com/.
#      Under `--clone`, the in-container clone inherits the host's origin, which
#      is usually an SSH URL; SSH cannot traverse the proxy (no keys, port 22
#      closed), but HTTPS does. The rewrite lets the worker's natural
#      `git push origin <branch>` transparently go over the authenticated HTTPS
#      path without having to add a separate remote.
# Done at runtime (plain files) rather than via the image or a kit, both of which
# break other sbx integrations (see cmd_spawn). Best-effort: a failure just means
# the worker may need to add an https remote / use the REST API for PRs.
wt_worker_configure_gh() {
  local sandbox=$1
  if sbx exec "$sandbox" -- bash -lc '
      mkdir -p ~/.config/gh \
        && printf "github.com:\n    oauth_token: proxy-managed\n    git_protocol: https\n" > ~/.config/gh/hosts.yml \
        && git config --global url."https://github.com/".insteadOf "git@github.com:" \
        && git config --global url."https://github.com/".pushInsteadOf "git@github.com:"' \
      >/dev/null 2>&1; then
    echo "wt-worker spawn: pre-authenticated gh + https rewrite on sandbox=$sandbox" >&2
  else
    echo "wt-worker spawn: could not pre-configure gh/git (worker can still use an https remote / REST API)" >&2
  fi
}

# Background refresher: periodically re-mint the sandbox's scoped GitHub token
# so workers that run longer than the 1-hour installation-token TTL keep working.
# Runs until the sandbox is removed (cleanup) or the process is killed.
wt_worker_refresh_loop() {
  local sandbox=$1 repo=$2
  local interval=${WT_WORKER_REFRESH_INTERVAL:-3000}  # 50 minutes (10 min margin)
  echo "[$(date +'%F %T')] refresher started (interval=${interval}s)"
  while sbx secret ls "$sandbox" >/dev/null 2>&1; do
    sleep "$interval"
    sbx secret ls "$sandbox" >/dev/null 2>&1 || break
    if wt_worker_inject_github_secret "$sandbox" "$repo" refresh; then
      echo "[$(date +'%F %T')] refreshed $sandbox"
    else
      echo "[$(date +'%F %T')] refresh failed for $sandbox (will retry next cycle)"
    fi
  done
  echo "[$(date +'%F %T')] sandbox $sandbox gone, refresher exiting"
}

# Detach the refresh loop as a background process. Survives terminal close via
# nohup; PID is recorded so cleanup can kill it explicitly.
wt_worker_start_refresher() {
  local branch=$1 sandbox=$2 repo=$3
  command -v agent-gh-repo-token >/dev/null 2>&1 || return 0
  local pid_file log_file
  pid_file=$(wt_worker_refresher_pid "$branch")
  log_file=$(wt_worker_refresher_log "$branch")
  mkdir -p "$(dirname "$pid_file")"
  # Re-exec self with the hidden subcommand so the loop is a separate process.
  nohup "${BASH_SOURCE[0]}" _refresh-loop "$sandbox" "$repo" \
    >>"$log_file" 2>&1 </dev/null &
  echo $! >"$pid_file"
  disown
  echo "wt-worker spawn: background refresher pid=$! log=$log_file" >&2
}

wt_worker_stop_refresher() {
  local branch=$1
  local pid_file pid
  pid_file=$(wt_worker_refresher_pid "$branch")
  [[ -f $pid_file ]] || return 0
  pid=$(cat "$pid_file")
  if [[ -n $pid ]] && kill "$pid" 2>/dev/null; then
    echo "wt-worker cleanup: stopped refresher pid=$pid" >&2
  fi
  rm -f "$pid_file"
}

# Emit one "<marketplace>/<plugin>" line per entry in config.toml.
# Silently emits nothing if the config file or yq/jq is missing.
wt_worker_read_plugins() {
  local cfg
  cfg=$(wt_worker_config_file)
  [[ -f $cfg ]] || return 0
  command -v yq >/dev/null 2>&1 || return 0
  command -v jq >/dev/null 2>&1 || return 0
  yq -p toml -o json '.marketplaces // []' "$cfg" 2>/dev/null \
    | jq -r '.[] | .name as $m | (.plugins // [])[] | "\($m)/\(.)"'
}

# Read a scalar from the [verify] table of config.toml (e.g. command, image).
# Emits the raw value or nothing if unset / config or yq missing.
wt_worker_verify_value() {
  local key=$1 cfg
  cfg=$(wt_worker_config_file)
  [[ -f $cfg ]] || return 0
  command -v yq >/dev/null 2>&1 || return 0
  yq -p toml ".verify.${key} // \"\"" "$cfg" 2>/dev/null
}

# Emit one container cache path per line from [verify].caches in config.toml.
# These are persisted across verify runs as per-repo named docker volumes so
# repeat installs (pnpm store, cargo registry, playwright browsers) stay fast.
wt_worker_verify_caches() {
  local cfg
  cfg=$(wt_worker_config_file)
  [[ -f $cfg ]] || return 0
  command -v yq >/dev/null 2>&1 || return 0
  yq -p toml '.verify.caches // [] | .[]' "$cfg" 2>/dev/null
}

# Resolve <marketplace>/<name> to the latest version directory under
# ~/.claude/plugins/cache/. Returns non-zero if not installed locally.
wt_worker_resolve_plugin_dir() {
  local marketplace=$1 name=$2
  local base="$HOME/.claude/plugins/cache/$marketplace/$name"
  [[ -d $base ]] || return 1
  local latest
  # shellcheck disable=SC2012  # version dirs are semver/'unknown', ls is fine
  latest=$(ls -1 "$base" 2>/dev/null | sort -V | tail -n1)
  [[ -n $latest && -d "$base/$latest" ]] || return 1
  echo "$base/$latest"
}

cmd_spawn() {
  local branch=${1:?usage: wt-worker spawn <branch> [initial-task]}
  local task=${2:-}
  local commander pane name toplevel
  commander=${WEZTERM_PANE:-}
  if [[ -z $commander ]]; then
    echo "wt-worker spawn: WEZTERM_PANE is not set. Run inside a WezTerm pane." >&2
    exit 1
  fi
  name="wt-worker-$(wt_worker_sanitize "$branch")"
  toplevel=$(git rev-parse --show-toplevel)

  mkdir -p "$(wt_worker_state_dir)/panes" "$(wt_worker_state_dir)/repos"

  # Resolve host plugins from ~/.config/wt-worker/config.toml.
  local extra_workspaces=() plugin_dirs=()
  local entry marketplace plugin_name host_dir
  while IFS= read -r entry; do
    [[ -z $entry || $entry == null/null ]] && continue
    marketplace=${entry%%/*}
    plugin_name=${entry#*/}
    if ! host_dir=$(wt_worker_resolve_plugin_dir "$marketplace" "$plugin_name"); then
      echo "wt-worker spawn: skipping plugin '$entry' (not installed locally)" >&2
      continue
    fi
    extra_workspaces+=("$host_dir:ro")
    plugin_dirs+=("$host_dir")
  done < <(wt_worker_read_plugins)

  # Create the sandbox via sbx using the STOCK claude image. Auth is handled by
  # the sbx proxy. We deliberately pass neither --template nor --kit: a custom
  # --template image loses sbx's transparent git-push credential injection (push
  # fails with "could not read Username"), and a --kit resets the agent's
  # Anthropic credential wiring (worker REPL shows "Not logged in"). gh + the
  # git https rewrite are pre-configured at runtime, below, with plain files.
  #
  # --clone runs the agent on a PRIVATE in-container clone of the repo (the host
  # repo is mounted read-only); there is no host-side worktree. The clone keeps
  # the host's `origin` (so the worker pushes branches straight to GitHub over
  # the proxy), and its commits are also reachable from the host via the
  # `sandbox-<name>` git remote while the `sbx run` session is live. sbx dropped
  # the old `--branch` flag; the worker creates the working branch itself (see
  # the setup line sent to the REPL below).
  sbx create --clone --name "$name" --quiet \
    claude "$toplevel" \
    ${extra_workspaces[@]+"${extra_workspaces[@]}"}

  # Mint a scoped GitHub App installation token for this sandbox (best-effort).
  # Must run AFTER sbx create (sandbox name must exist) and BEFORE sbx run
  # (the proxy reads secrets at run time). Also persist the repo so cmd_refresh
  # and the background refresher can re-mint without re-deriving from cwd.
  local origin
  if origin=$(wt_worker_origin_path); then
    echo "$origin" >"$(wt_worker_repo_file "$branch")"
    if wt_worker_inject_github_secret "$name" "$origin"; then
      wt_worker_configure_gh "$name"
      wt_worker_start_refresher "$branch" "$name" "$origin"
    fi
  else
    echo "wt-worker spawn: no 'origin' remote, skipping github auth" >&2
  fi

  # Open WezTerm pane anchored below the commander. There is no host worktree
  # under --clone, so anchor the pane at the repo root; the worker operates on
  # the in-container clone once `sbx run` attaches.
  pane=$(wezterm cli split-pane --bottom --percent 30 \
    --pane-id "$commander" --cwd "$toplevel")
  echo "$pane" > "$(wt_worker_pane_file "$branch")"

  # Build sbx run command; append -- --plugin-dir args if any plugins resolved
  local run_cmd="sbx run $name"
  if [[ ${#plugin_dirs[@]} -gt 0 ]]; then
    run_cmd="sbx run $name --"
    local pdir
    for pdir in "${plugin_dirs[@]}"; do
      run_cmd+=" --plugin-dir $pdir"
    done
  fi
  wt_worker_send_line "$pane" "$run_cmd"

  # The clone starts on the repo's default HEAD. sbx no longer creates the branch
  # (--branch is gone), so the worker establishes it. This setup line also states
  # the push/PR convention; the per-sandbox token + https rewrite (configured
  # above) make `git push -u origin <branch>` + `gh pr create` work directly.
  local setup="Create and switch to a new git branch '$branch' (git checkout -b $branch) for all work in this sandbox. When your changes are committed, run 'git push -u origin $branch' and open a PR with 'gh pr create'."
  sleep "${WT_WORKER_SPAWN_WAIT:-5}"
  if [[ -n $task ]]; then
    wt_worker_send_line "$pane" "$setup Task: $task"
  else
    wt_worker_send_line "$pane" "$setup"
  fi

  echo "wt-worker: spawned '$branch'"
  echo "  pane-id  = $pane"
  echo "  mode     = clone (in-container; no host worktree)"
  echo "  sandbox  = $name"
}

cmd_tell() {
  local branch=${1:?usage: wt-worker tell <branch> <message>}
  shift
  local message="$*"
  local pane_file pane
  pane_file=$(wt_worker_pane_file "$branch")
  if [[ ! -f $pane_file ]]; then
    echo "wt-worker tell: no worker named '$branch'." >&2
    exit 1
  fi
  pane=$(cat "$pane_file")
  wt_worker_send_line "$pane" "$message"
}

cmd_logs() {
  local branch=${1:?usage: wt-worker logs <branch> [-n <lines>]}
  local lines=200
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -n) lines=${2:?-n requires a number}; shift 2 ;;
      *) echo "wt-worker logs: unknown option '$1'" >&2; exit 1 ;;
    esac
  done
  local pane_file pane
  pane_file=$(wt_worker_pane_file "$branch")
  if [[ ! -f $pane_file ]]; then
    echo "wt-worker logs: no worker named '$branch'." >&2
    exit 1
  fi
  pane=$(cat "$pane_file")
  wezterm cli get-text --pane-id "$pane" --start-line "-$lines"
}

# Run the repo's test suite against a branch in a CLEAN linux container, so
# native-binding tooling (vite-plus/rolldown, playwright, esbuild, ...) and
# browser binaries match what CI runs — instead of the worker's dev sandbox,
# where the host's macOS node_modules are mounted and fail to load on linux.
#
# The committed branch tree is exported with `git archive` (no node_modules /
# target), piped into the container, and the user-declared [verify].command is
# run there. The container exit code propagates: 0 = pass, non-zero = fail.
# Caches (pnpm store, cargo, playwright) persist across runs as per-repo
# named docker volumes declared in [verify].caches.
cmd_verify() {
  local branch=${1:?usage: wt-worker verify <branch>}
  local toplevel repo image command
  toplevel=$(git rev-parse --show-toplevel)
  repo=$(basename "$toplevel")

  command=$(wt_worker_verify_value command)
  if [[ -z $command ]]; then
    echo "wt-worker verify: no [verify] command in $(wt_worker_config_file)." >&2
    echo "  Declare what 'verify' runs, e.g.:" >&2
    echo "    [verify]" >&2
    echo "    command = \"mise install && mise run web:e2e\"" >&2
    echo "    caches  = [\"/home/agent/.local/share/pnpm/store\"]" >&2
    exit 1
  fi
  image=$(wt_worker_verify_value image)
  [[ -n $image ]] || image="${WT_WORKER_VERIFY_IMAGE:-tedsum/claude-code-mise:latest}"

  # Resolve a git ref to export. Under --clone the worker pushes its branch to
  # GitHub rather than to a host worktree, so the branch usually is NOT a local
  # ref here — fetch it from origin. Prefer an existing local branch (e.g. the
  # user already fetched it) and fall back to fetching origin/<branch>.
  local ref
  if git -C "$toplevel" rev-parse --verify --quiet "refs/heads/$branch" >/dev/null; then
    ref=$branch
  elif git -C "$toplevel" fetch --quiet origin "$branch" 2>/dev/null; then
    ref=FETCH_HEAD
    echo "wt-worker verify: fetched '$branch' from origin" >&2
  else
    echo "wt-worker verify: branch '$branch' not found locally or on origin." >&2
    echo "  verify tests the pushed branch — make sure the worker has pushed it." >&2
    exit 1
  fi

  # Map each declared cache path to a deterministic per-repo named volume.
  local mounts=() path vol
  while IFS= read -r path; do
    [[ -z $path ]] && continue
    vol="wt-worker-verify-$(wt_worker_sanitize "$repo")-$(printf '%s' "$path" | tr -c 'A-Za-z0-9' '-')"
    mounts+=(-v "$vol:$path")
  done < <(wt_worker_verify_caches)

  echo "wt-worker verify: testing '$branch' ($ref) in clean container ($image)" >&2
  echo "wt-worker verify: command: $command" >&2

  # Run as root with HOME pinned to the image's agent home: the stock image runs
  # as a non-root user, so a fresh /work dir and freshly-created named cache
  # volumes (root-owned) would be unwritable. Root sidesteps both and matches
  # how CI typically runs; HOME=/home/agent keeps mise's shims/installs resolved.
  local rc=0
  git -C "$toplevel" archive --format=tar "$ref" \
    | docker run --rm -i --user root -e HOME=/home/agent \
        "${mounts[@]+"${mounts[@]}"}" \
        -e WT_WORKER_VERIFY=1 "$image" \
        bash -lc 'set -e; mkdir -p /work && tar -x -C /work && cd /work && '"$command" \
    || rc=$?

  if [[ $rc -eq 0 ]]; then
    echo "wt-worker verify: PASS (branch=$branch)" >&2
  else
    echo "wt-worker verify: FAIL rc=$rc (branch=$branch)" >&2
  fi
  return $rc
}

cmd_list() {
  sbx ls || true
}

cmd_refresh() {
  local branch=${1:?usage: wt-worker refresh <branch>}
  local name repo repo_file
  name="wt-worker-$(wt_worker_sanitize "$branch")"
  repo_file=$(wt_worker_repo_file "$branch")
  if [[ ! -f $repo_file ]]; then
    echo "wt-worker refresh: no recorded repo for '$branch' (was spawn run?)" >&2
    exit 1
  fi
  repo=$(cat "$repo_file")
  if ! sbx secret ls "$name" >/dev/null 2>&1; then
    echo "wt-worker refresh: sandbox '$name' is gone" >&2
    exit 1
  fi
  wt_worker_inject_github_secret "$name" "$repo" refresh
}

cmd_wait() {
  local branch=${1:?usage: wt-worker wait <branch> [-t <timeout>] [-i <interval>]}
  shift
  local timeout=0 interval=${WT_WORKER_WAIT_INTERVAL:-10}
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -t) timeout=${2:?-t requires seconds}; shift 2 ;;
      -i) interval=${2:?-i requires seconds}; shift 2 ;;
      *) echo "wt-worker wait: unknown option '$1'" >&2; exit 1 ;;
    esac
  done
  local pane_file pane
  pane_file=$(wt_worker_pane_file "$branch")
  if [[ ! -f $pane_file ]]; then
    echo "wt-worker wait: no worker named '$branch'." >&2
    exit 1
  fi
  pane=$(cat "$pane_file")

  local deadline=0
  [[ $timeout -gt 0 ]] && deadline=$(( $(date +%s) + timeout ))

  # Snapshot how many "Worked for" lines exist now so we only trigger on new ones.
  local initial_count=0
  initial_count=$(wezterm cli get-text --pane-id "$pane" --start-line "-200" 2>/dev/null \
    | grep -c 'Worked for' || true)

  echo "wt-worker wait: polling for completion (branch=$branch, interval=${interval}s)..." >&2

  while true; do
    local current_count=0
    current_count=$(wezterm cli get-text --pane-id "$pane" --start-line "-200" 2>/dev/null \
      | grep -c 'Worked for' || true)
    if [[ $current_count -gt $initial_count ]]; then
      echo "wt-worker wait: worker finished." >&2
      exit 0
    fi
    if [[ $deadline -gt 0 && $(date +%s) -ge $deadline ]]; then
      echo "wt-worker wait: timed out after ${timeout}s." >&2
      exit 1
    fi
    sleep "$interval"
  done
}

cmd_cleanup() {
  local branch=${1:?usage: wt-worker cleanup <branch>}
  local name pane pane_file repo_file
  name="wt-worker-$(wt_worker_sanitize "$branch")"
  pane_file=$(wt_worker_pane_file "$branch")
  repo_file=$(wt_worker_repo_file "$branch")

  # Stop the background refresher first so it doesn't race against sbx rm.
  wt_worker_stop_refresher "$branch"

  # --force: cleanup is non-interactive (also runs from scripts), so skip the
  # confirmation prompt. Without it sbx rm hangs/aborts when stdin isn't a TTY,
  # orphaning the sandbox while the pane is already gone.
  sbx rm --force "$name" 2>/dev/null || true

  # Under --clone there is no host worktree or local branch to remove (the work
  # lives in the in-container clone). The `sandbox-<name>` git remote dies with
  # the sbx run session, but drop it explicitly in case a stale entry remains.
  git remote remove "sandbox-$name" 2>/dev/null || true

  if [[ -f $pane_file ]]; then
    pane=$(cat "$pane_file")
    wezterm cli kill-pane --pane-id "$pane" 2>/dev/null || true
    rm -f "$pane_file"
  fi
  rm -f "$repo_file"

  echo "wt-worker: removed sandbox '$name' and killed pane."
}

cmd_help() {
  cat <<'EOF'
Usage: wt-worker <command> [args...]

Commands:
  spawn <branch> [<task>]    Create an in-container clone sandbox, start a worker
                             and tell it to work on <branch> (push + PR itself).
                             Also starts a background refresher that re-mints
                             the GitHub token every 50 min (best-effort).
  tell <branch> <message>    Send a message to a worker's REPL.
  logs <branch> [-n <lines>] Read the worker pane output (default: 200 lines).
  wait <branch> [-t <secs>] [-i <secs>]
                             Poll until the worker prints "Worked for" (one turn
                             finished). Exits 0 on completion, 1 on timeout.
                             -t sets timeout in seconds (default: none).
                             -i sets poll interval in seconds (default: 10).
  verify <branch>            Run [verify].command against the committed branch
                             in a clean linux container (CI-parity). Exits with
                             the test command's code. Needs docker + a [verify]
                             section in config.toml.
  list                       List active sandboxes (sbx ls).
  refresh <branch>           Manually re-mint the worker's scoped GitHub token
                             (normally automatic; useful if refresher died).
  cleanup <branch>           Remove sandbox, kill pane, stop refresher.
  help                       Show this help.

Env:
  WT_WORKER_SPAWN_WAIT       Seconds to wait before sending the initial task (default: 5)
  WT_WORKER_REFRESH_INTERVAL Seconds between background token refreshes (default: 3000)
  WT_WORKER_WAIT_INTERVAL    Default poll interval for wt-worker wait (default: 10)
  WT_WORKER_VERIFY_IMAGE     Default image for `verify` (default: tedsum/claude-code-mise:latest)
  XDG_CONFIG_HOME            Used to locate config.toml (default: ~/.config)

Auth:
  Anthropic:        sbx secret set -g anthropic         (global, once)
  GitHub (simple):  sbx secret set -g github            (global PAT fallback)
  GitHub (scoped):  install agent-gh-repo-token, then write
                    ~/.config/agent-gh-repo-token/repos.toml
    - if agent-gh-repo-token is on PATH and has a matching entry, spawn calls
      it with --repo <host>/<owner>/<repo> and stores the resulting token as
      the sandbox's `github` secret (scoped to this repo + configured
      permissions, expires in 1 hour).
    - install: see https://github.com/td72/agent-gh-repo-token

Config:
  ~/.config/wt-worker/config.toml
    [[marketplaces]]  plugins passed to the worker as extra read-only
                      workspaces and --plugin-dir args.
    [verify]          command (required to enable `verify`), optional image,
                      and caches (container paths persisted as named volumes).

Workers run on a private in-container clone (sbx --clone); the host repo is
mounted read-only and there is no host worktree. The worker pushes its branch
to GitHub directly; commits are also reachable via the sandbox-<name> remote
while the session is live.

See docs/worktree-workflow.md for design.
EOF
}

main() {
  local cmd=${1:-help}
  shift || true
  case "$cmd" in
    spawn)         cmd_spawn "$@" ;;
    tell)          cmd_tell "$@" ;;
    logs)          cmd_logs "$@" ;;
    wait)          cmd_wait "$@" ;;
    verify)        cmd_verify "$@" ;;
    list)          cmd_list "$@" ;;
    refresh)       cmd_refresh "$@" ;;
    cleanup)       cmd_cleanup "$@" ;;
    # Hidden: re-exec target for the background refresher (spawn auto-starts it).
    _refresh-loop) wt_worker_refresh_loop "$@" ;;
    help|-h|--help) cmd_help ;;
    *) echo "wt-worker: unknown command '$cmd'" >&2; cmd_help; exit 2 ;;
  esac
}

main "$@"
