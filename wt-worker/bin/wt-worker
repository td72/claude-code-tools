#!/usr/bin/env bash
# wt-worker - Claude Code parallel worker manager (WorkTree + WezTerm)
# See docs/worktree-workflow.md for design.
set -euo pipefail

wt_worker_state_dir() {
  local repo
  repo=$(basename "$(git rev-parse --show-toplevel)")
  echo "${XDG_STATE_HOME:-$HOME/.local/state}/wt-worker/${repo}"
}

wt_worker_pane_file() { echo "$(wt_worker_state_dir)/panes/$(wt_worker_sanitize "$1")"; }

wt_worker_sanitize() {
  # branch -> safe identifier for sbx name + filename
  printf '%s' "$1" | tr '/' '-'
}

wt_worker_send_line() {
  local pane=$1 text=$2
  wezterm cli send-text --no-paste --pane-id "$pane" "$text"
  printf '\r' | wezterm cli send-text --no-paste --pane-id "$pane"
}

wt_worker_config_file() {
  echo "${XDG_CONFIG_HOME:-$HOME/.config}/wt-worker/config.toml"
}

# Resolve "github.com/<owner>/<repo>" from the current repo's origin URL.
# Returns non-zero if origin is missing or not parseable.
wt_worker_origin_path() {
  local url
  url=$(git remote get-url origin 2>/dev/null) || return 1
  [[ -n $url ]] || return 1
  url=${url%.git}
  # ssh forms: git@host:owner/repo, ssh://git@host/owner/repo
  url=${url#ssh://}
  url=${url#git@}
  url=${url/:/\/}
  # https forms: https://host/owner/repo
  url=${url#https://}
  url=${url#http://}
  echo "$url"
}

# Mint a scoped GitHub App installation token via the external
# `agent-gh-repo-token` CLI (https://github.com/td72/agent-gh-repo-token) and
# store it as the sandbox's per-sandbox `github` secret. Best-effort: any
# failure just emits a warning and leaves the sandbox without GitHub auth
# (worker can still read public repos but cannot push). If the CLI is not
# installed, wt-worker silently falls back to the global `github` secret
# (if any).
wt_worker_inject_github_secret() {
  local sandbox=$1 repo=$2
  local err_file token
  if ! command -v agent-gh-repo-token >/dev/null 2>&1; then
    # No-op: fall back to whatever global `github` secret the user set.
    return 0
  fi
  err_file=$(mktemp -t agent-gh-repo-token.XXXXXX)
  if token=$(agent-gh-repo-token --repo "$repo" 2>"$err_file"); then
    rm -f "$err_file"
    if [[ -n $token ]]; then
      printf '%s' "$token" | sbx secret set "$sandbox" github >/dev/null
      echo "wt-worker spawn: scoped github token stored on sandbox=$sandbox" >&2
    fi
  else
    echo "wt-worker spawn: skipping github auth ($(cat "$err_file"))" >&2
    rm -f "$err_file"
  fi
}

# Emit one "<marketplace>/<plugin>" line per entry in config.toml.
# Silently emits nothing if the config file or yq/jq is missing.
wt_worker_read_plugins() {
  local cfg
  cfg=$(wt_worker_config_file)
  [[ -f $cfg ]] || return 0
  command -v yq >/dev/null 2>&1 || return 0
  command -v jq >/dev/null 2>&1 || return 0
  yq -p toml -o json '.marketplaces // []' "$cfg" 2>/dev/null \
    | jq -r '.[] | .name as $m | (.plugins // [])[] | "\($m)/\(.)"'
}

# Resolve <marketplace>/<name> to the latest version directory under
# ~/.claude/plugins/cache/. Returns non-zero if not installed locally.
wt_worker_resolve_plugin_dir() {
  local marketplace=$1 name=$2
  local base="$HOME/.claude/plugins/cache/$marketplace/$name"
  [[ -d $base ]] || return 1
  local latest
  # shellcheck disable=SC2012  # version dirs are semver/'unknown', ls is fine
  latest=$(ls -1 "$base" 2>/dev/null | sort -V | tail -n1)
  [[ -n $latest && -d "$base/$latest" ]] || return 1
  echo "$base/$latest"
}

cmd_spawn() {
  local branch=${1:?usage: wt-worker spawn <branch> [initial-task]}
  local task=${2:-}
  local commander pane name toplevel worktree
  commander=${WEZTERM_PANE:-}
  if [[ -z $commander ]]; then
    echo "wt-worker spawn: WEZTERM_PANE is not set. Run inside a WezTerm pane." >&2
    exit 1
  fi
  name="wt-worker-$(wt_worker_sanitize "$branch")"
  toplevel=$(git rev-parse --show-toplevel)

  mkdir -p "$(wt_worker_state_dir)/panes"

  # Resolve host plugins from ~/.config/wt-worker/config.toml.
  local extra_workspaces=() plugin_dirs=()
  local entry marketplace plugin_name host_dir
  while IFS= read -r entry; do
    [[ -z $entry || $entry == null/null ]] && continue
    marketplace=${entry%%/*}
    plugin_name=${entry#*/}
    if ! host_dir=$(wt_worker_resolve_plugin_dir "$marketplace" "$plugin_name"); then
      echo "wt-worker spawn: skipping plugin '$entry' (not installed locally)" >&2
      continue
    fi
    extra_workspaces+=("$host_dir:ro")
    plugin_dirs+=("$host_dir")
  done < <(wt_worker_read_plugins)

  # Create sandbox + worktree via sbx. Auth handled by sbx proxy.
  # Worktree lands at <toplevel>/.sbx/<name>-worktrees/<branch-sanitized>/
  sbx create --branch="$branch" --name "$name" --quiet \
    claude "$toplevel" \
    ${extra_workspaces[@]+"${extra_workspaces[@]}"}

  # Mint a scoped GitHub App installation token for this sandbox (best-effort).
  # Must run AFTER sbx create (sandbox name must exist) and BEFORE sbx run
  # (the proxy reads secrets at run time).
  local origin
  if origin=$(wt_worker_origin_path); then
    wt_worker_inject_github_secret "$name" "$origin"
  else
    echo "wt-worker spawn: no 'origin' remote, skipping github auth" >&2
  fi

  worktree="$toplevel/.sbx/$name-worktrees/$(wt_worker_sanitize "$branch")"

  # Open WezTerm pane anchored below the commander, cwd = worktree
  pane=$(wezterm cli split-pane --bottom --percent 30 \
    --pane-id "$commander" --cwd "$worktree")
  echo "$pane" > "$(wt_worker_pane_file "$branch")"

  # Build sbx run command; append -- --plugin-dir args if any plugins resolved
  local run_cmd="sbx run $name"
  if [[ ${#plugin_dirs[@]} -gt 0 ]]; then
    run_cmd="sbx run $name --"
    local pdir
    for pdir in "${plugin_dirs[@]}"; do
      run_cmd+=" --plugin-dir $pdir"
    done
  fi
  wt_worker_send_line "$pane" "$run_cmd"

  if [[ -n $task ]]; then
    sleep "${WT_WORKER_SPAWN_WAIT:-5}"
    wt_worker_send_line "$pane" "$task"
  fi

  echo "wt-worker: spawned '$branch'"
  echo "  pane-id  = $pane"
  echo "  worktree = $worktree"
  echo "  sandbox  = $name"
}

cmd_tell() {
  local branch=${1:?usage: wt-worker tell <branch> <message>}
  shift
  local message="$*"
  local pane_file pane
  pane_file=$(wt_worker_pane_file "$branch")
  if [[ ! -f $pane_file ]]; then
    echo "wt-worker tell: no worker named '$branch'." >&2
    exit 1
  fi
  pane=$(cat "$pane_file")
  wt_worker_send_line "$pane" "$message"
}

cmd_logs() {
  local branch=${1:?usage: wt-worker logs <branch> [-n <lines>]}
  local lines=200
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -n) lines=${2:?-n requires a number}; shift 2 ;;
      *) echo "wt-worker logs: unknown option '$1'" >&2; exit 1 ;;
    esac
  done
  local pane_file pane
  pane_file=$(wt_worker_pane_file "$branch")
  if [[ ! -f $pane_file ]]; then
    echo "wt-worker logs: no worker named '$branch'." >&2
    exit 1
  fi
  pane=$(cat "$pane_file")
  wezterm cli get-text --pane-id "$pane" --start-line "-$lines"
}

cmd_list() {
  sbx ls || true
}

cmd_cleanup() {
  local branch=${1:?usage: wt-worker cleanup <branch>}
  local name pane pane_file toplevel worktree_dir
  name="wt-worker-$(wt_worker_sanitize "$branch")"
  pane_file=$(wt_worker_pane_file "$branch")
  toplevel=$(git rev-parse --show-toplevel)
  worktree_dir="$toplevel/.sbx/$name-worktrees"

  sbx rm "$name" 2>/dev/null || true

  # sbx rm is best-effort on worktree cleanup; remove explicitly if still present
  if [[ -d $worktree_dir ]]; then
    git worktree remove --force "$worktree_dir/$(wt_worker_sanitize "$branch")" 2>/dev/null || true
    rmdir "$worktree_dir" 2>/dev/null || true
    git branch -D "$branch" 2>/dev/null || true
  fi

  if [[ -f $pane_file ]]; then
    pane=$(cat "$pane_file")
    wezterm cli kill-pane --pane-id "$pane" 2>/dev/null || true
    rm -f "$pane_file"
  fi

  echo "wt-worker: removed sandbox '$name' and killed pane."
}

cmd_help() {
  cat <<'EOF'
Usage: wt-worker <command> [args...]

Commands:
  spawn <branch> [<task>]    Create a worktree + sandbox, start a worker.
  tell <branch> <message>    Send a message to a worker's REPL.
  logs <branch> [-n <lines>] Read the worker pane output (default: 200 lines).
  list                       List active sandboxes (sbx ls).
  cleanup <branch>           Remove sandbox and kill pane.
  help                       Show this help.

Env:
  WT_WORKER_SPAWN_WAIT  Seconds to wait before sending the initial task (default: 5)
  XDG_CONFIG_HOME       Used to locate config.toml (default: ~/.config)

Auth:
  Anthropic:        sbx secret set -g anthropic         (global, once)
  GitHub (simple):  sbx secret set -g github            (global PAT fallback)
  GitHub (scoped):  install agent-gh-repo-token, then write
                    ~/.config/agent-gh-repo-token/repos.toml
    - if agent-gh-repo-token is on PATH and has a matching entry, spawn calls
      it with --repo <host>/<owner>/<repo> and stores the resulting token as
      the sandbox's `github` secret (scoped to this repo + configured
      permissions, expires in 1 hour).
    - install: see https://github.com/td72/agent-gh-repo-token

Config:
  ~/.config/wt-worker/config.toml — [[marketplaces]] whose plugins are passed
  to the worker as extra read-only workspaces and --plugin-dir args.

Worktrees are created under .sbx/ in the repository root.
Add .sbx/ to .gitignore to keep git status clean.

See docs/worktree-workflow.md for design.
EOF
}

main() {
  local cmd=${1:-help}
  shift || true
  case "$cmd" in
    spawn)   cmd_spawn "$@" ;;
    tell)    cmd_tell "$@" ;;
    logs)    cmd_logs "$@" ;;
    list)    cmd_list "$@" ;;
    cleanup) cmd_cleanup "$@" ;;
    help|-h|--help) cmd_help ;;
    *) echo "wt-worker: unknown command '$cmd'" >&2; cmd_help; exit 2 ;;
  esac
}

main "$@"
