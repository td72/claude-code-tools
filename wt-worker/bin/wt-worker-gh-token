#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#   "pyjwt[crypto]>=2.8",
#   "httpx>=0.27",
# ]
# ///
"""Mint a scoped GitHub App installation token for wt-worker.

Reads ~/.config/wt-worker/repos.toml, resolves the matching org/repo entry,
fetches App credentials from a 1Password item, generates a JWT, and prints
a fresh installation token (scoped to the current repo + configured
permissions) to stdout.

Usage:
  wt-worker-gh-token --origin github.com/td72/claude-code-tools

Exit codes:
  0   token printed to stdout
  >0  any failure (caller should skip github auth, NOT abort spawn)

Designed to be called from wt-worker spawn:
  if tok=$(wt-worker-gh-token --origin "$origin" 2>>"$log"); then
    echo "$tok" | sbx secret set "$name" github
  fi
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import time
import tomllib
from pathlib import Path
from typing import Any

import httpx
import jwt as pyjwt


def log(msg: str) -> None:
    print(f"wt-worker-gh-token: {msg}", file=sys.stderr)


def config_path() -> Path:
    base = os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))
    return Path(base) / "wt-worker" / "repos.toml"


def load_config(path: Path) -> dict[str, Any]:
    with path.open("rb") as f:
        return tomllib.load(f)


def resolve_entry(config: dict[str, Any], origin: str) -> dict[str, Any]:
    """Merge org-level entry under repo-level entry (repo wins per key).

    origin: "github.com/<owner>/<repo>"
    """
    parts = origin.split("/")
    if len(parts) < 3:
        raise ValueError(f"origin must be host/owner/repo, got: {origin!r}")
    org_key = "/".join(parts[:2])
    repo_key = origin
    org_entry = config.get(org_key, {})
    repo_entry = config.get(repo_key, {})
    # shallow merge: repo overrides org per top-level key
    return {**org_entry, **repo_entry}


def fetch_op_item(uri: str) -> dict[str, str]:
    """Return {label: value} for all labeled fields of a 1Password item."""
    proc = subprocess.run(
        ["op", "item", "get", uri, "--format=json"],
        capture_output=True,
        text=True,
        check=True,
    )
    data = json.loads(proc.stdout)
    fields: dict[str, str] = {}
    for field in data.get("fields") or []:
        label = field.get("label")
        value = field.get("value")
        if label and value is not None:
            fields[label] = value
    return fields


def make_jwt(app_id: str, private_key: str) -> str:
    now = int(time.time())
    payload = {
        # backdate 60s to tolerate clock skew between us and GitHub
        "iat": now - 60,
        "exp": now + 600,  # GitHub max is 10 minutes
        "iss": str(app_id),
    }
    return pyjwt.encode(payload, private_key, algorithm="RS256")


def mint_token(
    app_jwt: str,
    installation_id: str,
    repo_name: str,
    permissions: dict[str, str] | None,
) -> str:
    body: dict[str, Any] = {"repositories": [repo_name]}
    if permissions:
        body["permissions"] = permissions
    resp = httpx.post(
        f"https://api.github.com/app/installations/{installation_id}/access_tokens",
        headers={
            "Authorization": f"Bearer {app_jwt}",
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28",
        },
        json=body,
        timeout=10,
    )
    if resp.status_code >= 400:
        raise RuntimeError(
            f"GitHub API {resp.status_code}: {resp.text.strip()}"
        )
    return resp.json()["token"]


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--origin",
        required=True,
        help="github.com/<owner>/<repo> identifying the current repository",
    )
    parser.add_argument(
        "--config",
        type=Path,
        default=None,
        help=f"path to repos.toml (default: {config_path()})",
    )
    args = parser.parse_args()

    cfg_path = args.config or config_path()
    if not cfg_path.exists():
        log(f"no config at {cfg_path}")
        return 2

    config = load_config(cfg_path)
    entry = resolve_entry(config, args.origin)
    if not entry:
        log(f"no entry for {args.origin} or its org in {cfg_path}")
        return 3

    op_item = entry.get("op_item")
    fields: dict[str, str] = {}
    if op_item:
        try:
            fields = fetch_op_item(op_item)
        except subprocess.CalledProcessError as exc:
            log(f"op item get failed: {exc.stderr.strip()}")
            return 4

    # Config entries override op_item fields, op_item fills in the rest.
    app_id = entry.get("app_id") or fields.get("app_id")
    installation_id = entry.get("installation_id") or fields.get("installation_id")
    private_key = entry.get("private_key") or fields.get("private_key")

    missing = [
        name
        for name, value in (
            ("app_id", app_id),
            ("installation_id", installation_id),
            ("private_key", private_key),
        )
        if not value
    ]
    if missing:
        log(f"missing fields for {args.origin}: {missing}")
        return 5

    repo_name = args.origin.rsplit("/", 1)[-1]
    permissions = entry.get("permissions")

    try:
        app_jwt = make_jwt(str(app_id), str(private_key))
        token = mint_token(app_jwt, str(installation_id), repo_name, permissions)
    except Exception as exc:  # noqa: BLE001
        log(f"token mint failed: {exc}")
        return 6

    print(token)
    return 0


if __name__ == "__main__":
    sys.exit(main())
